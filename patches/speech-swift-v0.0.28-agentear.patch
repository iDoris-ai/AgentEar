@@ -4,6 +4,7 @@ import HummingbirdCore
 import HummingbirdWebSocket
 import NIOCore
 import Qwen3ASR
+import MLX
 import Qwen3TTS
 import Qwen3TTSCoreML
 import CosyVoiceTTS
@@ -1686,6 +1687,21 @@ func dispatchTranscribe(
         return (try? model.transcribeAudio(audio16k, sampleRate: 16000, language: language)) ?? ""
     case "qwen3-asr":
         let model = try await state.loadQwen3ASR(modelId: variant.modelId)
+        // ---- Modified by AgentEar (https://github.com/iDoris-ai/AgentEar), T3.5.9 ----
+        // 原版这条路径每次请求后不释放 MLX 用过的 Metal 缓冲区，常驻服务会越用越涨
+        // （0.6B 没有上游给 1.7B 准备的缓存上限保护）。两个环境变量都不设时行为与
