+        }
+        if env["AGENTEAR_MLX_CLEAR_ONLY"] != nil {
+            defer { MLX.Memory.clearCache() }
+            return try model.transcribeCheckingCancellation(
+                audio: audio16k, sampleRate: 16000, options: asrOptions)
+        }
+        // ---- end AgentEar modification ----
